<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mosaic</title>

    <link rel="stylesheet" href="/css/style.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Tiny5+Duo:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
</head>
<body data-room="<%= id %>">
    <div id="stage">
        <div class="loading">loading...</div>
        <canvas id="game"></canvas>
        
        <div id="gui">
            <div id="gui-left">
                <button id="leaveBtn">Leave</button>
                <button>Smiley</button>
                <button>Aura</button>
                <button>God</button>
            </div>

            <div id="gui-center">
                <div id="palette" hidden>
                    <div id="paletteButtons">
                        <button class="active">Blocks</button>
                        <button>Action</button>
                        <button>Decorative</button>
                        <button>Background</button>
                    </div>

                    <div id="paletteBlocks">
                        <div id="paletteBlocksBlocks">

                        </div>
                        <div id="paletteBlocksAction">

                        </div>
                        <div id="paletteBlocksDecorative">

                        </div>
                        <div id="paletteBlocksBackground">

                        </div>
                    </div>
                </div>

                <div class="hotbarRow">
                    <div id="hotbar"></div>
                    <button id="inventoryBtn">Blocks</button>
                </div>
            </div>

            <div id="gui-right">
                <button>Settings</button>
                <button>Map</button>
            </div>
        </div>
    </div>

    <script src="<%= script %>"></script>
    <script src="<%= global %>"></script>
</body>
</html>