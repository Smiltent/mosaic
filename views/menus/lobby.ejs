
<!-- Lobby -->
<div class="lobby">
    <div class="nav">
        <div class="navLeft">
            <button class="defaultButton">Energy Shop</button>
            <div class="energy">
                <div class="energyIcon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                        <defs>
                            <linearGradient id="energyGradient" gradientUnits="userSpaceOnuse" x1="0" y1="1" x2="0" y2="0">
                                <stop offset="0%" stop-color="#fe640b" />
                                <stop offset="100%" stop-color="rgb(247, 224, 12)" />
                            </linearGradient>
                        </defs>
                        <path fill="url(#energyGradient)" d="M434.8 54.1C446.7 62.7 451.1 78.3 445.7 91.9L367.3 288L512 288C525.5 288 537.5 296.4 542.1 309.1C546.7 321.8 542.8 336 532.5 344.6L244.5 584.6C233.2 594 217.1 594.5 205.2 585.9C193.3 577.3 188.9 561.7 194.3 548.1L272.7 352L128 352C114.5 352 102.5 343.6 97.9 330.9C93.3 318.2 97.2 304 107.5 295.4L395.5 55.4C406.8 46 422.9 45.5 434.8 54.1z"/>
                    </svg>
                </div>
                <div class="energyText">
                    <p>
                        Energy: <span id="energyAmount"><%= user.energy %></span>/<span id="energyMaxAmount"><%= user.maxEnergy %></span>
                    </p>
                    <p class="energyTextBelow">
                        More in <span id="energyTimeNext" data-secs="<%= energyNext %>">--:--</span>
                    </p>
                </div>
            </div>

            <div class="navSplitter"></div>

            <button class="defaultButton" id="githubBtn">GitHub</button>
        </div>
        <div class="navRight">
            <button class="defaultButton">Settings</button>

            <form action="/auth/logout" method="POST">
                <button class="defaultButton" type="submit">Logout</button>
            </form>
        </div>
    </div>

    <div class="main">
        <div class="header">
            <div class="headerH1">
                <h1>MOSAIC</h1>
                <p class="headerBetaTag">Unreleased</p>
            </div>

            <p>0 Online - <span id="headerMOTD">Lorem ipsum dolor sit amet!</span></p>
        </div>

        <div class="content">
            <div class="contentLeft">
                <div class="contentLeftHeader">
                    <p>GAMES</p>
                    <input type="text" id="search">
                    <button class="defaultButton" id="refreshGames"></button>
                </div>
                <div class="activeGamesButtons">
                    <button data-filter="online" class="active">Online</button>
                    <button data-filter="liked">Liked</button>
                    <button data-filter="friends">Friends</button>
                    <button data-filter="owned">Owned</button>
                </div>
                <div class="activeGames">
                    <% for (const w of worlds) { %>
                        <div class="game" data-game-redirect="/game/<%= w.id %>" data-online="<%= w.online %>" data-owned="<%= w.owned ? 1 : 0 %>" <%= w.online > 0 ? "" : 'style: "display: none;"' %>>
                            <div class="title">
                                <p><%= w.name %></p>
                            </div>
                            <div class="subtitle">
                                <span><%= w.online %> Online</span><p>-</p><span><%= w.likes %> Liked</span><p>-</p><span><%= w.plays %> Plays</span>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>

            <div class="contentRight">
                <div class="contentRightHeader">
                    <p><%= user.username %></p>
                </div>

                <div class="contentRightSmiley">

                </div>

                <div class="extraInfoButtons">
                    <button class="active">Friends</button>
                    <button>Worlds</button>
                    <button>Items</button>
                    <button>Wishlist</button>
                </div>

                <div class="extraInfo">
                    <form id="createWorld" data-action="/worlds">
                        <input type="text" name="name" placeholder="World name" maxlength="32" required>
                        <select name="type">
                            <% for (const [id, t] of Object.entries(worldTypes)) { %>
                                <option value="<%= id %>"><%= t.name %></option>
                            <% } %>
                        </select>
                        <button class="defaultButton" type="submit">Create</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="modal">
            
        </div>

        <div class="modal">

        </div>
    </div>
</div>
<!--  -->