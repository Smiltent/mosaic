
<!-- Verify Email -->
<div class="auth">
    <div class="authCard">
        <h1>MOSAIC</h1>
        <p>We emailed you a 6 digit code, check your e-mail.</p>

        <form data-action="/auth/verify" data-next="/lobby" id="auth">
            <input name="code" type="text" placeholder="123456" required inputmode="numeric" pattern="[0-9]{6}" maxlength="6">

            <p id="error"></p>

            <button type="submit">Verify</button>
        </form>

        <form action="/auth/resend" method="POST" class="authAlt">
            <button type="submit">Resend code</button>
        </form>
    </div>
</div>
